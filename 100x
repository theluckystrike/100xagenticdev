# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_deepseek() {
  info "Running DeepSeek multi-agent pipeline"
  cd "$SCRIPT_DIR/pipeline"
  python3 runner.py "$@"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: dashboard — Open Latest Dashboard
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_dashboard() {
  detect_project

  local latest
  latest=$(ls -td "$PROJECT_DIR/.100x/runs/"*/ 2>/dev/null | head -1)

  if [ -z "$latest" ]; then
    err "No pipeline runs found. Run: 100x run 'your task'"
    exit 1
  fi

  if [ -f "${latest}dashboard.html" ]; then
    info "Opening: ${latest}dashboard.html"
    open "${latest}dashboard.html" 2>/dev/null || echo "Open: ${latest}dashboard.html"
  else
    warn "No dashboard in latest run. Generating..."
    generate_dashboard "$latest" "Unknown" "0"
    open "${latest}dashboard.html" 2>/dev/null || echo "Open: ${latest}dashboard.html"
  fi
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Dashboard HTML Generator
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
generate_dashboard() {
  local run_dir="$1"
  local task="$2"
  local total_elapsed="${3:-0}"
  local output="$run_dir/dashboard.html"

  # Collect stage data
  local stages_json="[]"
  for meta in "$run_dir"/*.meta.json; do
    [ -f "$meta" ] || continue
    stages_json=$(echo "$stages_json" | jq --slurpfile s "$meta" '. + $s')
  done

  # Collect stage results
  local results=""
  for stage_file in "$run_dir"/0*.json; do
    [ -f "$stage_file" ] || continue
    local stage_name
    stage_name=$(basename "$stage_file" .json)
    local stage_result
    stage_result=$(jq -r '.result // "No output"' "$stage_file" 2>/dev/null | head -200 || echo "Error reading")
    results+="<div class='stage-result'>
      <h3>$stage_name</h3>
      <pre>$(echo "$stage_result" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')</pre>
    </div>"
  done

  cat > "$output" << 'DASHBOARD_EOF'
