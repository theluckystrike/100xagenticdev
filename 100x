#!/usr/bin/env bash
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  100x — The Agentic Engineering Pipeline CLI
#
#  Turn one developer into 100 through context engineering, multi-agent
#  orchestration, NASA Power of 10 quality gates, and budget enforcement.
#
#  Usage:
#    100x run "Add input validation to all API endpoints"
#    100x init
#    100x gate
#    100x parallel "task1" "task2" "task3"
#    100x dashboard
#    100x research "topic"
#    100x history
#    100x doctor
#
#  Install:
#    git clone https://github.com/theluckystrike/100xagenticdev.git
#    ln -sf ~/100xagenticdev/100x /usr/local/bin/100x
#
#  Based on: Karpathy's Context Engineering + RouteLLM + NASA P10
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
set -euo pipefail

VERSION="1.1.0"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_FILE="${HOME}/.100x.json"

# ── Colors ─────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Config Loading ────────────────────────────────────────────────────
load_config() {
  if [ -f "$CONFIG_FILE" ]; then
    BUDGET_MAX="${BUDGET_MAX:-$(jq -r '.budget_max // empty' "$CONFIG_FILE" 2>/dev/null || true)}"
    AUTONOMOUS="${AUTONOMOUS:-$(jq -r '.autonomous // empty' "$CONFIG_FILE" 2>/dev/null || true)}"
    SRC_DIR="${SRC_DIR:-$(jq -r '.src_dir // empty' "$CONFIG_FILE" 2>/dev/null || true)}"
  fi
}
load_config

# ── Defaults ───────────────────────────────────────────────────────────
BUDGET_MAX="${BUDGET_MAX:-10.00}"
MAX_TURNS_ANALYZE="${MAX_TURNS_ANALYZE:-8}"
MAX_TURNS_IMPLEMENT="${MAX_TURNS_IMPLEMENT:-30}"
MAX_TURNS_TEST="${MAX_TURNS_TEST:-15}"
MAX_TURNS_REVIEW="${MAX_TURNS_REVIEW:-8}"
MAX_TURNS_RESEARCH="${MAX_TURNS_RESEARCH:-20}"
PARALLEL_BUDGET="${PARALLEL_BUDGET:-2.00}"
PARALLEL_MAX_TURNS="${PARALLEL_MAX_TURNS:-30}"
AUTONOMOUS="${AUTONOMOUS:-false}"
SRC_DIR="${SRC_DIR:-src}"

# ── Helpers ────────────────────────────────────────────────────────────
banner() {
  echo -e "${PURPLE}${BOLD}"
  echo "  ╔══════════════════════════════════════════╗"
  echo "  ║         100x Agentic Pipeline            ║"
  echo "  ║   Context Engineering × Multi-Agent      ║"
  echo "  ║        × NASA P10 Quality Gates          ║"
  echo "  ╚══════════════════════════════════════════╝"
  echo -e "${NC}"
}

log() { echo -e "${DIM}[$(date +%H:%M:%S)]${NC} $1"; }
ok()  { echo -e "${GREEN}✓${NC} $1"; }
err() { echo -e "${RED}✗${NC} $1" >&2; }
warn(){ echo -e "${YELLOW}!${NC} $1"; }
info(){ echo -e "${BLUE}→${NC} $1"; }

check_claude() {
  if ! command -v claude &>/dev/null; then
    err "Claude CLI not found. Install: npm install -g @anthropic-ai/claude-code"
    exit 1
  fi
}

detect_project() {
  PROJECT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  PROJECT_NAME="$(basename "$PROJECT_DIR")"
}

detect_src_dir() {
  if [ -d "$PROJECT_DIR/src" ]; then SRC_DIR="src"
  elif [ -d "$PROJECT_DIR/lib" ]; then SRC_DIR="lib"
  elif [ -d "$PROJECT_DIR/app" ]; then SRC_DIR="app"
  else SRC_DIR="."
  fi
}

# Cross-platform open
open_file() {
  local filepath="$1"
  if command -v open &>/dev/null; then open "$filepath" 2>/dev/null || true
  elif command -v xdg-open &>/dev/null; then xdg-open "$filepath" 2>/dev/null || true
  elif command -v start &>/dev/null; then start "$filepath" 2>/dev/null || true
  else info "Open: $filepath"
  fi
}

# HTML-safe escaping via jq (no fragile sed)
html_escape() {
  local text="$1"
  echo "$text" | jq -Rs '.' | sed 's/^"//; s/"$//' | sed 's/\\n/\n/g; s/\\t/\t/g; s/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

# ── HARNESS: The System Prompt Injection ───────────────────────────────
build_harness() {
  local task="$1"
  local stage="${2:-implement}"

  local harness=""

  # Layer 1: NASA P10 rules (always)
  harness+="RULES — You MUST follow these (NASA Power of 10):
- Functions under 60 lines. No exceptions.
- All loops have fixed upper bounds.
- No dynamic memory after init.
- Check every return value.
- Zero warnings policy — treat warnings as errors.
- No global mutable state.
- Maximum 2 levels of pointer/reference indirection.
- All code paths must be testable.
- Minimize scope of variables.
- Use assertions liberally at function boundaries.

"

  # Layer 2: Context engineering (project-aware)
  if [ -f "$PROJECT_DIR/CLAUDE.md" ]; then
    harness+="PROJECT INSTRUCTIONS (from CLAUDE.md):
$(cat "$PROJECT_DIR/CLAUDE.md")

"
  fi

  # Layer 3: Stage-specific harness
  case "$stage" in
    analyze)
      harness+="STAGE: ANALYSIS
You are the planning agent. Your job:
1. Read and understand the codebase structure
2. Identify ALL files that need to change for this task
3. Output a numbered implementation plan
4. Estimate complexity (trivial/moderate/complex) per file
5. Flag any risks or architectural concerns
6. Do NOT write code — only analyze and plan

Be thorough but concise. List exact file paths.
"
      ;;
    implement)
      harness+="STAGE: IMPLEMENTATION
You are the coding agent. Your job:
1. Follow the plan exactly
2. Write production-quality code
3. After each change, verify it compiles/parses
4. Fix any errors immediately
5. Use existing patterns from the codebase
6. Do NOT over-engineer — minimal changes only
7. Do NOT add comments unless logic is non-obvious

Surgical precision. Change only what's needed.
"
      ;;
    test)
      harness+="STAGE: TESTING
You are the test agent. Your job:
1. Run the existing test suite
2. Fix any failing tests caused by recent changes
3. Add tests for new/changed code paths
4. Ensure edge cases are covered
5. Verify no regressions

If no test framework exists, note it and move on.
"
      ;;
    review)
      harness+="STAGE: REVIEW
You are the review agent. Your job:
1. Review ALL changes shown below
2. Check for: security issues, edge cases, code quality
3. Verify NASA P10 compliance (60-line functions, bounded loops, etc.)
4. Check for OWASP Top 10 vulnerabilities
5. Flag any concerns with severity (Critical/High/Medium/Low)
6. Verify no secrets or credentials in code

Output a structured review: APPROVE, REQUEST_CHANGES, or BLOCK.
"
      ;;
    research)
      harness+="STAGE: RESEARCH
You are a research agent. Your job:
1. Thoroughly research the given topic
2. Use web search and available tools
3. Provide data-driven analysis with specific numbers
4. Cite sources where possible
5. Structure output with clear headers
6. Be thorough but concise — no filler

Deliver actionable insights, not generic advice.
"
      ;;
  esac

  harness+="
TASK: $task
"
  echo "$harness"
}

# ── Budget Tracking (uses total_cost_usd from Claude CLI JSON) ────────
BUDGET_SPENT=0

track_cost() {
  local result_file="$1"
  local cost
  cost=$(jq -r '.total_cost_usd // 0' "$result_file" 2>/dev/null || echo "0")
  BUDGET_SPENT=$(echo "$BUDGET_SPENT + $cost" | bc 2>/dev/null || echo "$BUDGET_SPENT")
  local remaining
  remaining=$(echo "$BUDGET_MAX - $BUDGET_SPENT" | bc 2>/dev/null || echo "0")
  log "Budget: ${CYAN}\$${BUDGET_SPENT}${NC} / \$${BUDGET_MAX} (remaining: \$${remaining})"

  if (( $(echo "$BUDGET_SPENT >= $BUDGET_MAX" | bc -l 2>/dev/null || echo 0) )); then
    err "BUDGET EXCEEDED — pipeline halted"
    return 1
  fi
}

# ── Build Claude CLI flags ────────────────────────────────────────────
build_claude_flags() {
  local max_turns="$1"
  local flags="--output-format json --max-turns $max_turns"

  if [ "$AUTONOMOUS" = "true" ]; then
    flags+=" --permission-mode bypassPermissions"
  fi

  echo "$flags"
}

# ── Stage Runner ──────────────────────────────────────────────────────
run_stage() {
  local name="$1"
  local task="$2"
  local stage="$3"
  local max_turns="${4:-10}"
  local log_dir="$5"
  local outfile="$log_dir/${name}.json"

  echo ""
  echo -e "${BOLD}━━━ Stage: ${CYAN}${name}${NC} ${BOLD}━━━${NC}"
  info "Max turns: $max_turns | Budget remaining: \$$(echo "$BUDGET_MAX - $BUDGET_SPENT" | bc 2>/dev/null || echo "$BUDGET_MAX")"

  local harness
  harness="$(build_harness "$task" "$stage")"

  local claude_flags
  claude_flags="$(build_claude_flags "$max_turns")"

  local start_time
  start_time=$(date +%s)

  # shellcheck disable=SC2086
  claude -p "$harness" $claude_flags > "$outfile" 2>/dev/null || true

  local end_time
  end_time=$(date +%s)
  local elapsed=$((end_time - start_time))

  # Extract cost (Claude CLI uses total_cost_usd)
  local cost_usd
  cost_usd=$(jq -r '.total_cost_usd // 0' "$outfile" 2>/dev/null || echo "0")

  ok "Stage ${BOLD}${name}${NC} complete (${elapsed}s, \$${cost_usd})"
  track_cost "$outfile" || return 1

  # Save stage metadata
  jq -n \
    --arg name "$name" \
    --arg stage "$stage" \
    --argjson elapsed "$elapsed" \
    --arg cost "$cost_usd" \
    --arg status "complete" \
    '{name: $name, stage: $stage, elapsed_sec: $elapsed, cost_usd: ($cost|tonumber), status: $status}' \
    > "$log_dir/${name}.meta.json" 2>/dev/null || true
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: init
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_init() {
  detect_project
  banner
  info "Initializing 100x pipeline in ${BOLD}$PROJECT_DIR${NC}"

  # Copy CLAUDE.md if not present
  if [ ! -f "$PROJECT_DIR/CLAUDE.md" ]; then
    cp "$SCRIPT_DIR/CLAUDE.md" "$PROJECT_DIR/CLAUDE.md"
    ok "Created CLAUDE.md with NASA P10 rules"
  else
    warn "CLAUDE.md already exists — skipping"
  fi

  # Create .100x directory
  mkdir -p "$PROJECT_DIR/.100x/runs"
  ok "Created .100x/ pipeline directory"

  # Copy ESLint config if TypeScript/JavaScript project
  if [ -f "$PROJECT_DIR/package.json" ]; then
    if [ ! -f "$PROJECT_DIR/eslint.config.mjs" ]; then
      cp "$SCRIPT_DIR/config/nasa-p10-eslint.config.mjs" "$PROJECT_DIR/eslint.config.mjs"
      ok "Installed NASA P10 ESLint config"
    else
      warn "eslint.config.mjs already exists — skipping"
    fi
  fi

  # Gitignore .100x logs
  if [ -f "$PROJECT_DIR/.gitignore" ]; then
    if ! grep -q "^\.100x/" "$PROJECT_DIR/.gitignore" 2>/dev/null; then
      printf '\n# 100x pipeline logs\n.100x/\n' >> "$PROJECT_DIR/.gitignore"
      ok "Added .100x/ to .gitignore"
    fi
  fi

  echo ""
  ok "Project initialized! Run: ${BOLD}100x run \"your task\"${NC}"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: run — The Full 4-Stage Pipeline
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_run() {
  local task="${1:?Usage: 100x run 'task description'}"
  check_claude
  detect_project
  banner

  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local run_dir="$PROJECT_DIR/.100x/runs/$timestamp"
  mkdir -p "$run_dir"

  # Snapshot pre-run state for context chain
  git diff HEAD --stat > "$run_dir/pre-state.txt" 2>/dev/null || true
  git rev-parse HEAD > "$run_dir/pre-commit.txt" 2>/dev/null || true

  info "Project: ${BOLD}$PROJECT_NAME${NC}"
  info "Task: ${CYAN}$task${NC}"
  info "Budget: \$$BUDGET_MAX"
  info "Autonomous: $AUTONOMOUS"
  info "Logs: $run_dir/"
  echo ""

  # Save run metadata
  jq -n \
    --arg task "$task" \
    --arg project "$PROJECT_NAME" \
    --arg dir "$PROJECT_DIR" \
    --arg ts "$timestamp" \
    --arg budget "$BUDGET_MAX" \
    --arg auto "$AUTONOMOUS" \
    '{task: $task, project: $project, project_dir: $dir, timestamp: $ts, budget_usd: ($budget|tonumber), autonomous: $auto, stages: []}' \
    > "$run_dir/run.json"

  local pipeline_start
  pipeline_start=$(date +%s)

  # ── Stage 1: Analyze ──
  run_stage "01-analyze" "$task" "analyze" "$MAX_TURNS_ANALYZE" "$run_dir"

  # ── Stage 2: Implement (feeds analysis result) ──
  local plan
  plan=$(jq -r '.result // ""' "$run_dir/01-analyze.json" 2>/dev/null || echo "")
  run_stage "02-implement" "Execute this plan for: $task

ANALYSIS FROM PLANNING AGENT:
$plan" "implement" "$MAX_TURNS_IMPLEMENT" "$run_dir"

  # ── Capture changes for context chain ──
  local changes_diff=""
  changes_diff=$(git diff HEAD 2>/dev/null || echo "No git diff available")
  local changes_stat=""
  changes_stat=$(git diff HEAD --stat 2>/dev/null || echo "")
  # Save diff for later stages
  echo "$changes_diff" > "$run_dir/changes.diff"
  echo "$changes_stat" > "$run_dir/changes-stat.txt"

  # ── Stage 3: Test (knows what changed) ──
  run_stage "03-test" "Run all tests, fix failures, add coverage for changes made for: $task

FILES CHANGED BY IMPLEMENTATION AGENT:
$changes_stat

DIFF OF CHANGES:
$(echo "$changes_diff" | head -300)" "test" "$MAX_TURNS_TEST" "$run_dir"

  # ── Stage 4: Review (knows what changed) ──
  run_stage "04-review" "Review all changes made for: $task

FILES CHANGED:
$changes_stat

FULL DIFF TO REVIEW:
$(echo "$changes_diff" | head -500)" "review" "$MAX_TURNS_REVIEW" "$run_dir"

  # ── Pipeline Complete ──
  local pipeline_end
  pipeline_end=$(date +%s)
  local total_elapsed=$((pipeline_end - pipeline_start))

  echo ""
  echo -e "${BOLD}━━━ Pipeline Complete ━━━${NC}"
  ok "Total time: ${total_elapsed}s"
  ok "Total cost: \$${BUDGET_SPENT}"
  ok "Logs: $run_dir/"

  # Generate dashboard
  generate_dashboard "$run_dir" "$task" "$total_elapsed"
  ok "Dashboard: $run_dir/dashboard.html"
  echo ""
  info "Open dashboard: ${BOLD}open $run_dir/dashboard.html${NC}"

  open_file "$run_dir/dashboard.html"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: gate — Quality Gate Check
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_gate() {
  detect_project
  detect_src_dir
  banner
  info "Running quality gates in ${BOLD}$PROJECT_DIR${NC} (src: $SRC_DIR)"
  echo ""

  local passed=0
  local failed=0
  local skipped=0
  local gate_num=0

  run_gate() {
    local name="$1"
    local cmd="$2"
    gate_num=$((gate_num + 1))

    echo -ne "  ${DIM}[$gate_num]${NC} $name... "

    # Capture exit code properly before conditional
    local exit_code=0
    eval "$cmd" >/dev/null 2>&1 || exit_code=$?

    if [ $exit_code -eq 0 ]; then
      echo -e "${GREEN}PASS${NC}"
      passed=$((passed + 1))
    elif [ $exit_code -eq 127 ]; then
      echo -e "${YELLOW}SKIP${NC} (not installed)"
      skipped=$((skipped + 1))
    else
      echo -e "${RED}FAIL${NC}"
      failed=$((failed + 1))
    fi
  }

  # Auto-detect project type and run appropriate gates
  if [ -f "$PROJECT_DIR/package.json" ]; then
    run_gate "Prettier (format)"        "npx prettier --check '${SRC_DIR}/**/*.{ts,tsx,js,jsx}' 2>/dev/null"
    run_gate "ESLint (lint)"            "npx eslint --max-warnings 0 ${SRC_DIR}/ 2>/dev/null"
    run_gate "TypeScript (types)"       "npx tsc --noEmit 2>/dev/null"
    run_gate "Tests"                    "npx vitest run 2>/dev/null || npm test 2>/dev/null"
    run_gate "Semgrep (SAST)"           "semgrep --config 'p/owasp-top-ten' --error ${SRC_DIR}/ 2>/dev/null"
    run_gate "Gitleaks (secrets)"       "gitleaks detect --source . --no-git --no-banner 2>/dev/null"
    run_gate "npm audit (CVEs)"         "npm audit --audit-level=high 2>/dev/null"
  elif [ -f "$PROJECT_DIR/Cargo.toml" ]; then
    run_gate "cargo fmt (format)"       "cargo fmt -- --check 2>/dev/null"
    run_gate "cargo clippy (lint)"      "cargo clippy -- -D warnings 2>/dev/null"
    run_gate "cargo test"               "cargo test 2>/dev/null"
    run_gate "cargo audit (CVEs)"       "cargo audit 2>/dev/null"
    run_gate "Gitleaks (secrets)"       "gitleaks detect --source . --no-git --no-banner 2>/dev/null"
  elif [ -f "$PROJECT_DIR/go.mod" ]; then
    run_gate "gofmt (format)"           "test -z \"\$(gofmt -l .)\" 2>/dev/null"
    run_gate "go vet (lint)"            "go vet ./... 2>/dev/null"
    run_gate "go test"                  "go test ./... 2>/dev/null"
    run_gate "govulncheck (CVEs)"       "govulncheck ./... 2>/dev/null"
    run_gate "Gitleaks (secrets)"       "gitleaks detect --source . --no-git --no-banner 2>/dev/null"
  elif [ -f "$PROJECT_DIR/pyproject.toml" ] || [ -f "$PROJECT_DIR/setup.py" ]; then
    run_gate "ruff (lint)"              "ruff check . 2>/dev/null"
    run_gate "mypy (types)"             "mypy . 2>/dev/null"
    run_gate "pytest"                   "pytest 2>/dev/null || python3 -m pytest 2>/dev/null"
    run_gate "Semgrep (SAST)"           "semgrep --config 'p/owasp-top-ten' --error . 2>/dev/null"
    run_gate "Gitleaks (secrets)"       "gitleaks detect --source . --no-git --no-banner 2>/dev/null"
  else
    run_gate "Gitleaks (secrets)"       "gitleaks detect --source . --no-git --no-banner 2>/dev/null"
    warn "Unknown project type — only ran secret detection"
  fi

  echo ""
  if [ $failed -eq 0 ]; then
    ok "ALL GATES PASSED (${passed} pass, ${skipped} skip)"
  else
    err "${failed} GATE(S) FAILED (${passed} pass, ${skipped} skip)"
    exit 1
  fi
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: parallel — Multi-Agent Parallel Execution (with worktrees)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_parallel() {
  if [ $# -eq 0 ]; then
    err "Usage: 100x parallel 'task1' 'task2' 'task3'"
    exit 1
  fi

  check_claude
  detect_project
  banner

  # Verify we're in a git repo (required for worktrees)
  if ! git rev-parse --show-toplevel &>/dev/null; then
    err "Not a git repository. Parallel mode requires git for worktree isolation."
    exit 1
  fi

  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local run_dir="$PROJECT_DIR/.100x/runs/parallel-$timestamp"
  local worktree_base="$PROJECT_DIR/.100x/worktrees"
  mkdir -p "$run_dir" "$worktree_base"

  info "Launching ${BOLD}$#${NC} parallel agents with worktree isolation"
  info "Budget per agent: \$$PARALLEL_BUDGET"
  info "Max turns: $PARALLEL_MAX_TURNS"
  echo ""

  local pids=()
  local tasks=("$@")
  local claude_flags
  claude_flags="$(build_claude_flags "$PARALLEL_MAX_TURNS")"

  for i in "${!tasks[@]}"; do
    local agent_id=$((i + 1))
    local branch="100x-agent-${agent_id}-${timestamp}"
    local worktree="$worktree_base/agent-${agent_id}"

    # Clean stale worktree
    git worktree remove "$worktree" --force 2>/dev/null || true

    # Create isolated worktree
    git worktree add "$worktree" -b "$branch" HEAD 2>/dev/null

    (
      cd "$worktree"
      local harness
      harness="$(build_harness "${tasks[$i]}" "implement")"

      info "Agent $agent_id: ${tasks[$i]:0:60}..."
      # shellcheck disable=SC2086
      claude -p "$harness" $claude_flags \
        > "$run_dir/agent-$agent_id.json" 2>/dev/null || true

      # Auto-commit if there are changes
      if ! git diff --quiet HEAD 2>/dev/null; then
        git add -A 2>/dev/null || true
        git commit -m "100x agent $agent_id: ${tasks[$i]:0:50}..." 2>/dev/null || true
      fi
      ok "Agent $agent_id complete"
    ) &
    pids+=($!)
    echo -e "  Agent $agent_id launched on branch ${CYAN}$branch${NC}"
  done

  echo ""
  info "Waiting for ${#pids[@]} agents..."
  local agent_failed=0
  for i in "${!pids[@]}"; do
    if ! wait "${pids[$i]}"; then
      err "Agent $((i + 1)) failed"
      agent_failed=$((agent_failed + 1))
    else
      ok "Agent $((i + 1)) done"
    fi
  done

  echo ""
  echo -e "${BOLD}━━━ Parallel Execution Complete ━━━${NC}"

  # Summary
  local total_cost=0
  for i in "${!tasks[@]}"; do
    local agent_id=$((i + 1))
    local cost
    cost=$(jq -r '.total_cost_usd // 0' "$run_dir/agent-$agent_id.json" 2>/dev/null || echo "0")
    total_cost=$(echo "$total_cost + $cost" | bc 2>/dev/null || echo "$total_cost")
    echo -e "  Agent $agent_id: \$$cost — ${tasks[$i]:0:50}"
  done
  echo ""
  ok "Total cost: \$$total_cost"

  # Cleanup worktrees
  for i in "${!tasks[@]}"; do
    local agent_id=$((i + 1))
    git worktree remove "$worktree_base/agent-$agent_id" --force 2>/dev/null || true
  done

  ok "Worktrees cleaned up"
  info "Review agent branches: ${BOLD}git log --all --oneline --graph${NC}"

  BUDGET_SPENT="$total_cost"
  generate_dashboard "$run_dir" "Parallel: ${#tasks[@]} agents" "0"
  open_file "$run_dir/dashboard.html"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: research — Deep Research (no double-harness)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_research() {
  local topic="${1:?Usage: 100x research 'topic'}"
  check_claude
  detect_project
  banner

  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local run_dir="$PROJECT_DIR/.100x/runs/research-$timestamp"
  mkdir -p "$run_dir"

  info "Research topic: ${CYAN}$topic${NC}"
  info "Budget: \$$BUDGET_MAX"
  echo ""

  # FIX: Pass raw topic to run_stage, let run_stage call build_harness once
  run_stage "research" "Deep research: $topic. Search the web extensively. Cover multiple angles: technical, market, competitive, risks, opportunities. Provide data-driven analysis with specific numbers and sources. Structure with clear headers. Be thorough." "research" "$MAX_TURNS_RESEARCH" "$run_dir"

  echo ""
  ok "Research complete"
  ok "Results: $run_dir/"

  # Extract and display result
  local result
  result=$(jq -r '.result // "See log file"' "$run_dir/research.json" 2>/dev/null || echo "See log file")
  echo ""
  echo -e "${BOLD}━━━ Research Results ━━━${NC}"
  echo "$result" | head -100

  generate_dashboard "$run_dir" "Research: $topic" "0"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: deepseek — Run DeepSeek Multi-Agent Pipeline
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_deepseek() {
  info "Running DeepSeek multi-agent pipeline"
  cd "$SCRIPT_DIR/pipeline"
  python3 runner.py "$@"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: history — Show Past Pipeline Runs
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_history() {
  detect_project
  local runs_dir="$PROJECT_DIR/.100x/runs"

  if [ ! -d "$runs_dir" ] || [ -z "$(ls -A "$runs_dir" 2>/dev/null)" ]; then
    err "No pipeline runs found. Run: 100x run 'your task'"
    exit 1
  fi

  banner
  echo -e "${BOLD}Pipeline History${NC} — $PROJECT_NAME"
  echo ""
  printf "  ${DIM}%-18s %-10s %-8s %s${NC}\n" "TIMESTAMP" "COST" "TIME" "TASK"
  printf "  ${DIM}%-18s %-10s %-8s %s${NC}\n" "──────────────────" "──────────" "────────" "────────────────────────────────"

  local total_cost=0
  local total_runs=0

  # shellcheck disable=SC2012,SC2045
  for run_dir in $(ls -td "$runs_dir"/*/); do
    [ -d "$run_dir" ] || continue

    local ts
    ts=$(basename "$run_dir")
    local task="unknown"
    local cost="0"
    local elapsed="?"

    if [ -f "$run_dir/run.json" ]; then
      task=$(jq -r '.task // "unknown"' "$run_dir/run.json" 2>/dev/null || echo "unknown")
    fi

    # Sum costs from all stage JSON files
    local run_cost=0
    for stage_json in "$run_dir"/*.json; do
      [ -f "$stage_json" ] || continue
      local stage_cost
      stage_cost=$(jq -r '.total_cost_usd // 0' "$stage_json" 2>/dev/null || echo "0")
      run_cost=$(echo "$run_cost + $stage_cost" | bc 2>/dev/null || echo "$run_cost")
    done

    total_cost=$(echo "$total_cost + $run_cost" | bc 2>/dev/null || echo "$total_cost")
    total_runs=$((total_runs + 1))

    # Format timestamp
    local display_ts
    display_ts=$(echo "$ts" | sed 's/_/ /; s/\([0-9]\{4\}\)\([0-9]\{2\}\)\([0-9]\{2\}\)/\1-\2-\3/')

    printf "  %-18s ${GREEN}\$%-9s${NC} %-8s %s\n" "$display_ts" "$run_cost" "${elapsed}s" "${task:0:40}"
  done

  echo ""
  echo -e "  ${BOLD}Total: $total_runs runs, \$${total_cost}${NC}"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: doctor — Check Prerequisites
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_doctor() {
  banner
  echo -e "${BOLD}Prerequisite Check${NC}"
  echo ""

  local ok_count=0
  local warn_count=0
  local fail_count=0

  check_tool() {
    local name="$1"
    local cmd="$2"
    local required="$3"
    local install_hint="$4"

    echo -ne "  $name... "
    if command -v "$cmd" &>/dev/null; then
      local ver
      ver=$($cmd --version 2>&1 | head -1 | grep -oE '[0-9]+\.[0-9]+[.0-9]*' | head -1 || echo "?")
      echo -e "${GREEN}OK${NC} (v$ver)"
      ok_count=$((ok_count + 1))
    elif [ "$required" = "required" ]; then
      echo -e "${RED}MISSING${NC} — $install_hint"
      fail_count=$((fail_count + 1))
    else
      echo -e "${YELLOW}OPTIONAL${NC} — $install_hint"
      warn_count=$((warn_count + 1))
    fi
  }

  echo -e "  ${DIM}Required:${NC}"
  check_tool "Claude CLI" "claude" "required" "npm install -g @anthropic-ai/claude-code"
  check_tool "git" "git" "required" "brew install git"
  check_tool "jq" "jq" "required" "brew install jq"
  check_tool "bc" "bc" "required" "brew install bc"

  echo ""
  echo -e "  ${DIM}Quality gates (JS/TS):${NC}"
  check_tool "Node.js" "node" "optional" "brew install node"
  check_tool "npx" "npx" "optional" "comes with Node.js"

  echo ""
  echo -e "  ${DIM}Quality gates (Python):${NC}"
  check_tool "Python 3" "python3" "optional" "brew install python3"
  check_tool "ruff" "ruff" "optional" "pip install ruff"

  echo ""
  echo -e "  ${DIM}Security tools:${NC}"
  check_tool "Semgrep" "semgrep" "optional" "pip install semgrep"
  check_tool "Gitleaks" "gitleaks" "optional" "brew install gitleaks"

  echo ""
  echo -e "  ${DIM}DeepSeek pipeline:${NC}"
  check_tool "httpx (Python)" "python3" "optional" "pip install httpx"
  if [ -n "${DEEPSEEK_API_KEY:-}" ]; then
    echo -e "  DEEPSEEK_API_KEY... ${GREEN}SET${NC}"
    ok_count=$((ok_count + 1))
  else
    echo -e "  DEEPSEEK_API_KEY... ${YELLOW}NOT SET${NC} (needed for 100x deepseek)"
    warn_count=$((warn_count + 1))
  fi

  echo ""
  if [ $fail_count -eq 0 ]; then
    ok "All required tools present (${ok_count} ok, ${warn_count} optional missing)"
  else
    err "${fail_count} required tool(s) missing. Install them and re-run."
    exit 1
  fi
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: config — Persistent Settings
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_config() {
  if [ $# -eq 0 ]; then
    # Show current config
    banner
    echo -e "${BOLD}Configuration${NC} ($CONFIG_FILE)"
    echo ""
    if [ -f "$CONFIG_FILE" ]; then
      jq '.' "$CONFIG_FILE"
    else
      echo "  No config file. Using defaults."
    fi
    echo ""
    echo -e "  ${DIM}Usage:${NC}"
    echo "    100x config set budget_max 25"
    echo "    100x config set autonomous true"
    echo "    100x config set src_dir lib"
    return
  fi

  local action="${1:-}"
  shift || true

  case "$action" in
    set)
      local key="${1:?Usage: 100x config set <key> <value>}"
      local value="${2:?Usage: 100x config set <key> <value>}"

      # Create config if missing
      if [ ! -f "$CONFIG_FILE" ]; then
        echo '{}' > "$CONFIG_FILE"
      fi

      # Update key
      local tmp
      tmp=$(mktemp)
      jq --arg k "$key" --arg v "$value" '.[$k] = $v' "$CONFIG_FILE" > "$tmp"
      mv "$tmp" "$CONFIG_FILE"
      ok "Set $key = $value"
      ;;
    get)
      local key="${1:?Usage: 100x config get <key>}"
      if [ -f "$CONFIG_FILE" ]; then
        jq -r --arg k "$key" '.[$k] // "not set"' "$CONFIG_FILE"
      else
        echo "not set"
      fi
      ;;
    *)
      err "Unknown config action: $action (use set/get)"
      exit 1
      ;;
  esac
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: dashboard — Open Latest Dashboard
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_dashboard() {
  detect_project

  local latest
  # shellcheck disable=SC2012
  latest=$(ls -td "$PROJECT_DIR/.100x/runs/"*/ 2>/dev/null | head -1)

  if [ -z "$latest" ]; then
    err "No pipeline runs found. Run: 100x run 'your task'"
    exit 1
  fi

  if [ -f "${latest}dashboard.html" ]; then
    info "Opening: ${latest}dashboard.html"
    open_file "${latest}dashboard.html"
  else
    warn "No dashboard in latest run. Generating..."
    BUDGET_SPENT="0"
    generate_dashboard "$latest" "Unknown" "0"
    open_file "${latest}dashboard.html"
  fi
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Dashboard HTML Generator (uses jq for safe escaping)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
generate_dashboard() {
  local run_dir="$1"
  local task="$2"
  local total_elapsed="${3:-0}"
  local output="$run_dir/dashboard.html"

  # Collect stage results safely via jq
  local results_html=""
  for stage_file in "$run_dir"/0*.json "$run_dir"/research.json; do
    [ -f "$stage_file" ] || continue
    local stage_name
    stage_name=$(basename "$stage_file" .json)
    local stage_result
    stage_result=$(jq -r '.result // "No output"' "$stage_file" 2>/dev/null | head -200 || echo "Error reading")
    # Escape HTML via jq
    local escaped_result
    escaped_result=$(printf '%s' "$stage_result" | jq -Rs '.' | sed 's/^"//;s/"$//' | sed 's/\\n/<br>/g; s/\\t/\&nbsp;\&nbsp;\&nbsp;\&nbsp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/&lt;br&gt;/<br>/g')
    results_html+="<div class=\"stage-result\"><h3>$stage_name</h3><pre>$escaped_result</pre></div>"
  done

  # Calculate budget bar width dynamically
  local budget_pct=0
  if [ "$(echo "$BUDGET_MAX > 0" | bc -l 2>/dev/null || echo 0)" = "1" ]; then
    budget_pct=$(echo "scale=0; $BUDGET_SPENT * 100 / $BUDGET_MAX" | bc 2>/dev/null || echo "0")
  fi
  local budget_class="low"
  if [ "$budget_pct" -gt 80 ] 2>/dev/null; then budget_class="high"
  elif [ "$budget_pct" -gt 50 ] 2>/dev/null; then budget_class="mid"
  fi

  # Escape task for HTML
  local safe_task
  safe_task=$(printf '%s' "$task" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g')

  # Write dashboard (static CSS block, then dynamic content)
  cat > "$output" << 'CSSEOF'
