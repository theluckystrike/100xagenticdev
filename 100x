# ── Parallel Dashboard ────────────────────────────────────────────────
generate_parallel_dashboard() {
  local run_dir="$1"
  shift
  local tasks=("$@")
  # Reuse main dashboard with parallel info
  generate_dashboard "$run_dir" "Parallel: ${#tasks[@]} agents" "0"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: help
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_help() {
  banner
  echo -e "${BOLD}USAGE${NC}"
  echo "  100x <command> [args]"
  echo ""
  echo -e "${BOLD}COMMANDS${NC}"
  echo -e "  ${CYAN}run${NC} \"task\"         Run 4-stage pipeline (analyze → implement → test → review)"
  echo -e "  ${CYAN}init${NC}               Initialize project with CLAUDE.md + NASA P10 config"
  echo -e "  ${CYAN}gate${NC}               Run 7-stage quality gate check"
  echo -e "  ${CYAN}parallel${NC} t1 t2 ..  Run N tasks in parallel agents"
  echo -e "  ${CYAN}research${NC} \"topic\"   Deep research with harness-boosted agent"
  echo -e "  ${CYAN}deepseek${NC} [args]    Run DeepSeek 20-agent pipeline (needs API key)"
  echo -e "  ${CYAN}dashboard${NC}          Open latest pipeline dashboard"
  echo -e "  ${CYAN}help${NC}               Show this help"
  echo ""
  echo -e "${BOLD}ENVIRONMENT${NC}"
  echo "  BUDGET_MAX          Pipeline budget in USD (default: 10.00)"
  echo "  MAX_TURNS_ANALYZE   Max agent turns for analysis (default: 8)"
  echo "  MAX_TURNS_IMPLEMENT Max agent turns for implementation (default: 30)"
  echo "  MAX_TURNS_TEST      Max agent turns for testing (default: 15)"
  echo "  MAX_TURNS_REVIEW    Max agent turns for review (default: 8)"
  echo "  DEEPSEEK_API_KEY    API key for DeepSeek pipeline"
  echo ""
  echo -e "${BOLD}EXAMPLES${NC}"
  echo "  100x run \"Add input validation to all API endpoints\""
  echo "  100x run \"Fix the authentication bug in login flow\""
  echo "  100x parallel \"Add dark mode\" \"Add i18n\" \"Add analytics\""
  echo "  100x research \"MCP server ecosystem and monetization\""
  echo "  BUDGET_MAX=25 100x run \"Refactor entire auth system\""
  echo ""
  echo -e "${BOLD}THE FORMULA${NC}"
  echo "  100x = CLAUDE.md + Harness (6-10x) + Routing (85% ↓) + Caching (90% ↓)"
  echo "       + Quality Gates (NASA P10) + Budget (\$47K prevention) + Multi-Agent"
  echo ""
  echo -e "${DIM}v${VERSION} — github.com/theluckystrike/100xagenticdev${NC}"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Main Router
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
main() {
  local cmd="${1:-help}"
  shift 2>/dev/null || true

  case "$cmd" in
    run)       cmd_run "$@" ;;
    init)      cmd_init "$@" ;;
    gate)      cmd_gate "$@" ;;
    parallel)  cmd_parallel "$@" ;;
    research)  cmd_research "$@" ;;
    deepseek)  cmd_deepseek "$@" ;;
    dashboard) cmd_dashboard "$@" ;;
    help|--help|-h) cmd_help ;;
    version|--version|-v) echo "100x v$VERSION" ;;
    *) err "Unknown command: $cmd"; cmd_help; exit 1 ;;
  esac
}

main "$@"
