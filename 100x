#!/usr/bin/env bash
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  100x — The Agentic Engineering Pipeline CLI
#
#  Turn one developer into 100 through context engineering, multi-agent
#  orchestration, NASA Power of 10 quality gates, and budget enforcement.
#
#  Usage:
#    100x run "Add input validation to all API endpoints"
#    100x init
#    100x gate
#    100x parallel "task1" "task2" "task3"
#    100x dashboard
#    100x research "topic"
#    100x deepseek --preset crypto_research --topic "Solana DeFi"
#
#  Install:
#    git clone https://github.com/theluckystrike/100xagenticdev.git
#    ln -sf ~/100xagenticdev/100x /usr/local/bin/100x
#
#  Based on: Karpathy's Context Engineering + RouteLLM + NASA P10
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
set -euo pipefail

VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# ── Colors ─────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Defaults ───────────────────────────────────────────────────────────
BUDGET_MAX="${BUDGET_MAX:-10.00}"
MAX_TURNS_ANALYZE="${MAX_TURNS_ANALYZE:-8}"
MAX_TURNS_IMPLEMENT="${MAX_TURNS_IMPLEMENT:-30}"
MAX_TURNS_TEST="${MAX_TURNS_TEST:-15}"
MAX_TURNS_REVIEW="${MAX_TURNS_REVIEW:-8}"
MAX_TURNS_RESEARCH="${MAX_TURNS_RESEARCH:-20}"
PARALLEL_BUDGET="${PARALLEL_BUDGET:-2.00}"
PARALLEL_MAX_TURNS="${PARALLEL_MAX_TURNS:-30}"

# ── Helpers ────────────────────────────────────────────────────────────
banner() {
  echo -e "${PURPLE}${BOLD}"
  echo "  ╔══════════════════════════════════════════╗"
  echo "  ║         100x Agentic Pipeline            ║"
  echo "  ║   Context Engineering × Multi-Agent      ║"
  echo "  ║        × NASA P10 Quality Gates          ║"
  echo "  ╚══════════════════════════════════════════╝"
  echo -e "${NC}"
}

log() { echo -e "${DIM}[$(date +%H:%M:%S)]${NC} $1"; }
ok()  { echo -e "${GREEN}✓${NC} $1"; }
err() { echo -e "${RED}✗${NC} $1" >&2; }
warn(){ echo -e "${YELLOW}!${NC} $1"; }
info(){ echo -e "${BLUE}→${NC} $1"; }

check_claude() {
  if ! command -v claude &>/dev/null; then
    err "Claude CLI not found. Install: npm install -g @anthropic-ai/claude-code"
    exit 1
  fi
}

detect_project() {
  PROJECT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  PROJECT_NAME="$(basename "$PROJECT_DIR")"
}

# ── HARNESS: The System Prompt Injection ───────────────────────────────
# This is where the 6-10x multiplier comes from. The harness wraps every
# Claude invocation with context engineering rules.
build_harness() {
  local task="$1"
  local stage="${2:-implement}"

  local harness=""

  # Layer 1: NASA P10 rules (always)
  harness+="RULES — You MUST follow these (NASA Power of 10):
- Functions under 60 lines. No exceptions.
- All loops have fixed upper bounds.
- No dynamic memory after init.
- Check every return value.
- Zero warnings policy — treat warnings as errors.
- No global mutable state.
- Maximum 2 levels of pointer/reference indirection.
- All code paths must be testable.
- Minimize scope of variables.
- Use assertions liberally at function boundaries.

"

  # Layer 2: Context engineering (project-aware)
  if [ -f "$PROJECT_DIR/CLAUDE.md" ]; then
    harness+="PROJECT INSTRUCTIONS (from CLAUDE.md):
$(head -100 "$PROJECT_DIR/CLAUDE.md")

"
  fi

  # Layer 3: Stage-specific harness
  case "$stage" in
    analyze)
      harness+="STAGE: ANALYSIS
You are the planning agent. Your job:
1. Read and understand the codebase structure
2. Identify ALL files that need to change for this task
3. Output a numbered implementation plan
4. Estimate complexity (trivial/moderate/complex) per file
5. Flag any risks or architectural concerns
6. Do NOT write code — only analyze and plan

Be thorough but concise. List exact file paths.
"
      ;;
    implement)
      harness+="STAGE: IMPLEMENTATION
You are the coding agent. Your job:
1. Follow the plan exactly
2. Write production-quality code
3. After each change, verify it compiles/parses
4. Fix any errors immediately
5. Use existing patterns from the codebase
6. Do NOT over-engineer — minimal changes only
7. Do NOT add comments unless logic is non-obvious

Surgical precision. Change only what's needed.
"
      ;;
    test)
      harness+="STAGE: TESTING
You are the test agent. Your job:
1. Run the existing test suite
2. Fix any failing tests
3. Add tests for new/changed code paths
4. Ensure edge cases are covered
5. Verify no regressions

If no test framework exists, note it and move on.
"
      ;;
    review)
      harness+="STAGE: REVIEW
You are the review agent. Your job:
1. Review ALL changes made in this session (git diff)
2. Check for: security issues, edge cases, code quality
3. Verify NASA P10 compliance (60-line functions, bounded loops, etc.)
4. Check for OWASP Top 10 vulnerabilities
5. Flag any concerns with severity (Critical/High/Medium/Low)
6. Verify no secrets or credentials in code

Output a structured review: APPROVE, REQUEST_CHANGES, or BLOCK.
"
      ;;
    research)
      harness+="STAGE: RESEARCH
You are a research agent. Your job:
1. Thoroughly research the given topic
2. Use web search and available tools
3. Provide data-driven analysis with specific numbers
4. Cite sources where possible
5. Structure output with clear headers
6. Be thorough but concise — no filler

Deliver actionable insights, not generic advice.
"
      ;;
  esac

  harness+="
TASK: $task
"
  echo "$harness"
}

# ── Budget Tracking ───────────────────────────────────────────────────
BUDGET_SPENT=0

track_cost() {
  local result_file="$1"
  local cost
  cost=$(jq -r '.cost_usd // .total_cost_usd // 0' "$result_file" 2>/dev/null || echo "0")
  BUDGET_SPENT=$(echo "$BUDGET_SPENT + $cost" | bc 2>/dev/null || echo "$BUDGET_SPENT")
  local remaining
  remaining=$(echo "$BUDGET_MAX - $BUDGET_SPENT" | bc 2>/dev/null || echo "0")
  log "Budget: ${CYAN}\$${BUDGET_SPENT}${NC} / \$${BUDGET_MAX} (remaining: \$${remaining})"

  if (( $(echo "$BUDGET_SPENT >= $BUDGET_MAX" | bc -l 2>/dev/null || echo 0) )); then
    err "BUDGET EXCEEDED — pipeline halted"
    return 1
  fi
}

# ── Stage Runner ──────────────────────────────────────────────────────
run_stage() {
  local name="$1"
  local task="$2"
  local stage="$3"
  local max_turns="${4:-10}"
  local log_dir="$5"
  local outfile="$log_dir/${name}.json"

  echo ""
  echo -e "${BOLD}━━━ Stage: ${CYAN}${name}${NC} ${BOLD}━━━${NC}"
  info "Max turns: $max_turns | Budget remaining: \$$(echo "$BUDGET_MAX - $BUDGET_SPENT" | bc 2>/dev/null || echo "$BUDGET_MAX")"

  local harness
  harness="$(build_harness "$task" "$stage")"

  local remaining_budget
  remaining_budget=$(echo "$BUDGET_MAX - $BUDGET_SPENT" | bc 2>/dev/null || echo "$BUDGET_MAX")

  local start_time
  start_time=$(date +%s)

  claude -p "$harness" \
    --output-format json \
    --max-turns "$max_turns" \
    > "$outfile" 2>&1 || true

  local end_time
  end_time=$(date +%s)
  local elapsed=$((end_time - start_time))

  # Extract result
  local result
  result=$(jq -r '.result // "No result"' "$outfile" 2>/dev/null || echo "See log")

  # Extract cost from session data
  local cost_usd
  cost_usd=$(jq -r '.cost_usd // 0' "$outfile" 2>/dev/null || echo "0")

  ok "Stage ${BOLD}${name}${NC} complete (${elapsed}s)"
  track_cost "$outfile" || return 1

  # Save stage metadata
  jq -n \
    --arg name "$name" \
    --arg stage "$stage" \
    --arg elapsed "$elapsed" \
    --arg cost "$cost_usd" \
    --arg status "complete" \
    '{name: $name, stage: $stage, elapsed_sec: ($elapsed|tonumber), cost_usd: ($cost|tonumber), status: $status}' \
    > "$log_dir/${name}.meta.json" 2>/dev/null || true
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: init
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_init() {
  detect_project
  banner
  info "Initializing 100x pipeline in ${BOLD}$PROJECT_DIR${NC}"

  # Copy CLAUDE.md if not present
  if [ ! -f "$PROJECT_DIR/CLAUDE.md" ]; then
    cp "$SCRIPT_DIR/CLAUDE.md" "$PROJECT_DIR/CLAUDE.md"
    ok "Created CLAUDE.md with NASA P10 rules"
  else
    warn "CLAUDE.md already exists — skipping"
  fi

  # Create .100x directory
  mkdir -p "$PROJECT_DIR/.100x/runs"
  ok "Created .100x/ pipeline directory"

  # Copy ESLint config if TypeScript/JavaScript project
  if [ -f "$PROJECT_DIR/package.json" ]; then
    if [ ! -f "$PROJECT_DIR/eslint.config.mjs" ]; then
      cp "$SCRIPT_DIR/config/nasa-p10-eslint.config.mjs" "$PROJECT_DIR/eslint.config.mjs"
      ok "Installed NASA P10 ESLint config"
    else
      warn "eslint.config.mjs already exists — skipping"
    fi
  fi

  # Gitignore .100x logs
  if [ -f "$PROJECT_DIR/.gitignore" ]; then
    if ! grep -q ".100x/" "$PROJECT_DIR/.gitignore" 2>/dev/null; then
      echo -e "\n# 100x pipeline logs\n.100x/" >> "$PROJECT_DIR/.gitignore"
      ok "Added .100x/ to .gitignore"
    fi
  fi

  echo ""
  ok "Project initialized! Run: ${BOLD}100x run \"your task\"${NC}"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: run — The Full 4-Stage Pipeline
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_run() {
  local task="${1:?Usage: 100x run 'task description'}"
  check_claude
  detect_project
  banner

  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local run_dir="$PROJECT_DIR/.100x/runs/$timestamp"
  mkdir -p "$run_dir"

  info "Project: ${BOLD}$PROJECT_NAME${NC}"
  info "Task: ${CYAN}$task${NC}"
  info "Budget: \$$BUDGET_MAX"
  info "Logs: $run_dir/"
  echo ""

  # Save run metadata
  jq -n \
    --arg task "$task" \
    --arg project "$PROJECT_NAME" \
    --arg dir "$PROJECT_DIR" \
    --arg ts "$timestamp" \
    --arg budget "$BUDGET_MAX" \
    '{task: $task, project: $project, project_dir: $dir, timestamp: $ts, budget_usd: ($budget|tonumber), stages: []}' \
    > "$run_dir/run.json"

  local pipeline_start
  pipeline_start=$(date +%s)

  # ── Stage 1: Analyze ──
  run_stage "01-analyze" "$task" "analyze" "$MAX_TURNS_ANALYZE" "$run_dir"

  # ── Stage 2: Implement (feeds analysis) ──
  local plan
  plan=$(jq -r '.result // ""' "$run_dir/01-analyze.json" 2>/dev/null || echo "")
  run_stage "02-implement" "Execute this plan for: $task

ANALYSIS FROM PLANNING AGENT:
$plan" "implement" "$MAX_TURNS_IMPLEMENT" "$run_dir"

  # ── Stage 3: Test ──
  run_stage "03-test" "Run all tests, fix failures, add coverage for changes made for: $task" "test" "$MAX_TURNS_TEST" "$run_dir"

  # ── Stage 4: Review ──
  run_stage "04-review" "Review all changes made for: $task" "review" "$MAX_TURNS_REVIEW" "$run_dir"

  # ── Pipeline Complete ──
  local pipeline_end
  pipeline_end=$(date +%s)
  local total_elapsed=$((pipeline_end - pipeline_start))

  echo ""
  echo -e "${BOLD}━━━ Pipeline Complete ━━━${NC}"
  ok "Total time: ${total_elapsed}s"
  ok "Total cost: \$${BUDGET_SPENT}"
  ok "Logs: $run_dir/"

  # Generate dashboard
  generate_dashboard "$run_dir" "$task" "$total_elapsed"
  ok "Dashboard: $run_dir/dashboard.html"
  echo ""
  info "Open dashboard: ${BOLD}open $run_dir/dashboard.html${NC}"

  # Open dashboard automatically on macOS
  if command -v open &>/dev/null; then
    open "$run_dir/dashboard.html" 2>/dev/null || true
  fi
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: gate — Quality Gate Check
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_gate() {
  detect_project
  banner
  info "Running quality gates in ${BOLD}$PROJECT_DIR${NC}"
  echo ""

  local passed=0
  local failed=0
  local skipped=0
  local total=0

  run_gate() {
    local name="$1"
    local cmd="$2"
    total=$((total + 1))

    echo -ne "  ${DIM}[$total/7]${NC} $name... "
    if eval "$cmd" &>/dev/null 2>&1; then
      echo -e "${GREEN}PASS${NC}"
      passed=$((passed + 1))
    else
      local exit_code=$?
      if [ $exit_code -eq 127 ]; then
        echo -e "${YELLOW}SKIP${NC} (not installed)"
        skipped=$((skipped + 1))
      else
        echo -e "${RED}FAIL${NC}"
        failed=$((failed + 1))
      fi
    fi
  }

  # Run gates (cheapest first)
  run_gate "Prettier (format)"        "npx prettier --check 'src/**/*.{ts,tsx,js,jsx}' 2>/dev/null"
  run_gate "ESLint (lint)"            "npx eslint --max-warnings 0 src/ 2>/dev/null"
  run_gate "TypeScript (types)"       "npx tsc --noEmit 2>/dev/null"
  run_gate "Tests"                    "npx vitest run 2>/dev/null || npm test 2>/dev/null"
  run_gate "Semgrep (SAST)"           "semgrep --config 'p/owasp-top-ten' --error src/ 2>/dev/null"
  run_gate "Gitleaks (secrets)"       "gitleaks detect --source . --no-git --no-banner 2>/dev/null"
  run_gate "npm audit (CVEs)"         "npm audit --audit-level=high 2>/dev/null"

  echo ""
  if [ $failed -eq 0 ]; then
    ok "ALL GATES PASSED (${passed} pass, ${skipped} skip)"
  else
    err "${failed} GATE(S) FAILED (${passed} pass, ${skipped} skip)"
    exit 1
  fi
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: parallel — Multi-Agent Parallel Execution
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_parallel() {
  if [ $# -eq 0 ]; then
    err "Usage: 100x parallel 'task1' 'task2' 'task3'"
    exit 1
  fi

  check_claude
  detect_project
  banner

  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local run_dir="$PROJECT_DIR/.100x/runs/parallel-$timestamp"
  mkdir -p "$run_dir"

  info "Launching ${BOLD}$#${NC} parallel agents"
  info "Budget per agent: \$$PARALLEL_BUDGET"
  info "Max turns: $PARALLEL_MAX_TURNS"
  echo ""

  local pids=()
  local tasks=("$@")

  for i in "${!tasks[@]}"; do
    local agent_id=$((i + 1))
    (
      local harness
      harness="$(build_harness "${tasks[$i]}" "implement")"

      info "Agent $agent_id: ${tasks[$i]:0:60}..."
      claude -p "$harness" \
        --output-format json \
        --max-turns "$PARALLEL_MAX_TURNS" \
        > "$run_dir/agent-$agent_id.json" 2>&1 || true

      ok "Agent $agent_id complete"
    ) &
    pids+=($!)
  done

  # Wait for all
  local agent_failed=0
  for i in "${!pids[@]}"; do
    if ! wait "${pids[$i]}"; then
      err "Agent $((i + 1)) failed"
      agent_failed=$((agent_failed + 1))
    fi
  done

  echo ""
  echo -e "${BOLD}━━━ Parallel Execution Complete ━━━${NC}"

  # Summary
  local total_cost=0
  for i in "${!tasks[@]}"; do
    local agent_id=$((i + 1))
    local cost
    cost=$(jq -r '.cost_usd // 0' "$run_dir/agent-$agent_id.json" 2>/dev/null || echo "0")
    total_cost=$(echo "$total_cost + $cost" | bc 2>/dev/null || echo "$total_cost")
    echo -e "  Agent $agent_id: ${tasks[$i]:0:50}... — \$$cost"
  done
  echo ""
  ok "Total cost: \$$total_cost"
  ok "Results: $run_dir/"

  generate_parallel_dashboard "$run_dir" "${tasks[@]}"
  info "Dashboard: ${BOLD}open $run_dir/dashboard.html${NC}"

  if command -v open &>/dev/null; then
    open "$run_dir/dashboard.html" 2>/dev/null || true
  fi
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  COMMAND: research — Deep Research with Fan-Out
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cmd_research() {
  local topic="${1:?Usage: 100x research 'topic'}"
  check_claude
  detect_project
  banner

  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local run_dir="$PROJECT_DIR/.100x/runs/research-$timestamp"
  mkdir -p "$run_dir"

  info "Research topic: ${CYAN}$topic${NC}"
  info "Budget: \$$BUDGET_MAX"
  echo ""

  local harness
  harness="$(build_harness "Deep research: $topic. Search the web extensively. Cover multiple angles: technical, market, competitive, risks, opportunities. Provide data-driven analysis with specific numbers and sources. Structure with clear headers. Be thorough." "research")"

  run_stage "research" "$harness" "research" "$MAX_TURNS_RESEARCH" "$run_dir"

  echo ""
  ok "Research complete"
  ok "Results: $run_dir/"

  # Extract and display result
  local result
  result=$(jq -r '.result // "See log file"' "$run_dir/research.json" 2>/dev/null || echo "See log file")
  echo ""
  echo -e "${BOLD}━━━ Research Results ━━━${NC}"
  echo "$result" | head -100

  generate_dashboard "$run_dir" "Research: $topic" "0"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
